{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/33hankei-afk/radar-telegram-reports/blob/main/schema/telegram_summaries_v1.schema.json",
  "title": "Radar domestic Telegram daily report v1",
  "type": "object",
  "required": [
    "schema",
    "date_kst",
    "observed_at_kst",
    "entries",
    "coverage_note"
  ],
  "properties": {
    "schema": {
      "const": "telegram_summaries_v1"
    },
    "date_kst": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "observed_at_kst": {
      "type": "string",
      "format": "date-time"
    },
    "coverage_note": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/post"
      }
    },
    "top20_urls": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/telegramUrl"
      }
    },
    "theme_urls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/telegramUrl"
      }
    },
    "consensus_up": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consensus"
      }
    },
    "consensus_down": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consensus"
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "target_channels": {
          "const": 59
        },
        "verified_full_channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "partial_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_post_count": {
          "type": "integer",
          "minimum": 0
        },
        "ranking_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "telegramUrl": {
      "type": "string",
      "pattern": "^https://t\\.me/[A-Za-z0-9_]+/[1-9][0-9]*$"
    },
    "post": {
      "type": "object",
      "required": [
        "channel",
        "post_id",
        "url",
        "views_display",
        "published_at_kst",
        "title",
        "summary_ko"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 5
        },
        "post_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "url": {
          "$ref": "#/$defs/telegramUrl"
        },
        "views_display": {
          "type": "string",
          "minLength": 1
        },
        "published_at_kst": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string"
        },
        "summary_ko": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_text": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "consensus": {
      "type": "object",
      "required": [
        "channel",
        "post_id",
        "url",
        "company",
        "published_at_kst"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "post_id": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/telegramUrl"
        },
        "company": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "basis_date": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "change_absolute": {
          "type": "string"
        },
        "change_percent": {
          "type": "string"
        },
        "published_at_kst": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
